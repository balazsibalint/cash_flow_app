# LLM-tartalék: openrouter | gemini | none
LLM_PROVIDER=openrouter

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Közvetlen Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Korlátok
LLM_TIMEOUT_SECONDS=60
LLM_MAX_CALLS_PER_BATCH=30
MAX_UPLOAD_MB=20

# Adatbázis kapcsolat
DATABASE_URL=sqlite:///./data/invoices.db

# MNB árfolyam-webszolgáltatás
MNB_URL=http://www.mnb.hu/arfolyamok.asmx

# A saját cég adatai (ez alapján dől el, hogy egy számla bejövő vagy kimenő)
OWN_COMPANY_NAME=Nordwind Solutions Kft.
OWN_TAX_NUMBER=26481937-2-43
OWN_EU_VAT=HU26481937