# LLM-tartalék (egyetlen OpenAI-kompatibilis kliens): openrouter | gemini | none
LLM_PROVIDER=openrouter

# OpenRouter (éles / kiértékelés)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Közvetlen Gemini API (csak fejlesztéshez, LLM_PROVIDER=gemini mellett)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# LLM-korlátok
LLM_TIMEOUT_SECONDS=60
LLM_MAX_CONCURRENCY=2
LLM_MAX_CALLS_PER_DAY=200

# Feltöltés és tárolás (a konténerben /app/data = named volume)
MAX_UPLOAD_MB=20
DATABASE_URL=sqlite:///./data/app.db
DATA_DIR=./data

# MNB árfolyam-webszolgáltatás (a POST csak http-n működik)
MNB_URL=http://www.mnb.hu/arfolyamok.asmx
MNB_TIMEOUT_SECONDS=20

# A saját cég adatai (ez alapján dől el, hogy egy számla bejövő vagy kimenő)
OWN_COMPANY_NAME=Nordwind Solutions Kft.
OWN_TAX_NUMBER=26481937-2-43
OWN_EU_VAT=HU26481937
